<mxfile host="app.diagrams.net"><diagram name="DFD-4. Бухучёт, кадры, зарплата и склад (1С) (As-Is)" id="dfd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="902" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;DFD-4. Бухучёт, кадры, зарплата и склад (1С) (As-Is)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Сотрудник компании&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Бухгалтер&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="180" height="70" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Кладовщик&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="180" height="70" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;Поставщик&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="180" height="70" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;4.1 Вести кадровый учёт и&lt;br&gt;начислять зарплату&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="250" height="90" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;4.2 Готовить отчётность в ФНС и&lt;br&gt;фонды&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="240" width="250" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;4.3 Вести учёт ТМЦ и закупок&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="450" width="250" height="90" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;4.4 Обмениваться данными между 1С&lt;br&gt;[OLE]&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="610" width="250" height="90" as="geometry"/></mxCell><mxCell id="11" value='&lt;b&gt;D5 1С:Бухгалтерия предприятия (файловый&lt;br&gt;режим)&lt;/b&gt;&lt;br&gt;&lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="110" width="310" height="75" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;ФНС, СФР и другие госорганы&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="360" width="250" height="70" as="geometry"/></mxCell><mxCell id="13" value='&lt;b&gt;D7 1С:Торговля и склад (файловый режим)&lt;/b&gt;&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="310" height="70" as="geometry"/></mxCell><mxCell id="14" value='паспортные данные, ИНН, СНИЛС,&lt;br&gt;реквизиты, больничные листы&lt;br&gt;&lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value='кадровые приказы и начисления&lt;br&gt;&lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value='кадровые и зарплатные данные&lt;br&gt;&lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="7" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="17" value='данные для отчётности&lt;br&gt;&lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="11" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="18" value='подготовка и проверка отчётов&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="4" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value='налоговая и страховая отчётность&lt;br&gt;&lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="8" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value='приход, расход, списание ТМЦ&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value='накладные, счета, реквизиты&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="6" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value='движение ТМЦ&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="9" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value='документы по ТМЦ и закупкам&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="13" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value='проводки по закупкам&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="10" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Прямоугольник - внешний субъект (человек или система)&lt;br&gt;Скруглённый блок - процесс; открытая полоса - хранилище данных; стрелка - поток данных&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; - медицинские данные (специальная категория ПДн, 152-ФЗ ст. 10); &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; - персональные данные; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; - платёжные и финансовые; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; - данные сотрудников; &lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt; - коммерческие; &lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt; - обезличенные; &lt;font color="#595959"&gt;&lt;b&gt;OPS&lt;/b&gt;&lt;/font&gt; - служебные события и оповещения&lt;br&gt;Пунктирная линия или рамка - предположение: в описании кейса этого прямо нет' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="750" width="1330" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>