<mxfile host="app.diagrams.net"><diagram name="DFD-3. Приём оплаты и работа с ККМ (As-Is)" id="dfd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="892" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;DFD-3. Приём оплаты и работа с ККМ (As-Is)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Кассир&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="180" height="70" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Бухгалтер&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="180" height="70" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;3.1 Принять оплату за услугу&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="250" height="90" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;3.2 Пробить чек на ККМ&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="200" width="250" height="90" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;3.3 Передать платёж в&lt;br&gt;1С:Бухгалтерия&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="330" width="250" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;3.4 Продублировать платёж в Excel&lt;br&gt;(двойной учёт)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="600" width="250" height="90" as="geometry"/></mxCell><mxCell id="10" value="&lt;b&gt;3.5 Провести платежи и сверить&lt;br&gt;учёт&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="460" width="250" height="90" as="geometry"/></mxCell><mxCell id="11" value="&lt;b&gt;ККМ (контрольно-кассовая&lt;br&gt;машина)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="180" height="70" as="geometry"/></mxCell><mxCell id="12" value="&lt;b&gt;ОФД и ФНС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1310" y="110" width="150" height="70" as="geometry"/></mxCell><mxCell id="13" value='&lt;b&gt;D5 1С:Бухгалтерия предприятия (файловый&lt;br&gt;режим)&lt;/b&gt;&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="350" width="310" height="75" as="geometry"/></mxCell><mxCell id="14" value='&lt;b&gt;D6 Excel: журнал платежей кассира&lt;/b&gt;&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="590" width="310" height="70" as="geometry"/></mxCell><mxCell id="15" value='оплата: ФИО плательщика, услуга,&lt;br&gt;сумма&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="3" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value='сумма и вид услуги&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="17" value='кассовый чек&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="7" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="18" value='кассовая операция&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value='данные чека&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="7" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value='сведения о принятых деньгах&lt;br&gt;[TCP/IP, OLE]&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="11" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value='фискальные данные чека (54-ФЗ)&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.75;entryX=0;entryY=0.75;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="7" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value='платёж, плательщик, услуга&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="8" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value='ручной ввод дубля платежа&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="4" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value='запись платежа&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="9" target="14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value='проведение платежей&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="5" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="26" value='платежи для сверки&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.25;entryX=1;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27" value='платежи кассира для сверки&lt;br&gt;двойного учёта&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="14" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value='проводки&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;exitX=1;exitY=0.75;entryX=0;entryY=0.75;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Прямоугольник - внешний субъект (человек или система)&lt;br&gt;Скруглённый блок - процесс; открытая полоса - хранилище данных; стрелка - поток данных&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; - медицинские данные (специальная категория ПДн, 152-ФЗ ст. 10); &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; - персональные данные; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; - платёжные и финансовые; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; - данные сотрудников; &lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt; - коммерческие; &lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt; - обезличенные; &lt;font color="#595959"&gt;&lt;b&gt;OPS&lt;/b&gt;&lt;/font&gt; - служебные события и оповещения&lt;br&gt;Пунктирная линия или рамка - предположение: в описании кейса этого прямо нет' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="1420" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>