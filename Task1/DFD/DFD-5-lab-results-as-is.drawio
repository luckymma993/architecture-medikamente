parent="1" source="12" target="9"><mxGeometry x="-0.5" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value='файлы пациента&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="13" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value='результаты для приёма&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="9" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="26" value='результаты (на руки или по почте)&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="9" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Прямоугольник - внешний субъект (человек или система)&lt;br&gt;Скруглённый блок - процесс; открытая полоса - хранилище данных; стрелка - поток данных&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; - медицинские данные (специальная категория ПДн, 152-ФЗ ст. 10); &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; - персональные данные; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; - платёжные и финансовые; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; - данные сотрудников; &lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt; - коммерческие; &lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt; - обезличенные; &lt;font color="#595959"&gt;&lt;b&gt;OPS&lt;/b&gt;&lt;/font&gt; - служебные события и оповещения&lt;br&gt;Пунктирная линия или рамка - предположение: в описании кейса этого прямо нет' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1330" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>