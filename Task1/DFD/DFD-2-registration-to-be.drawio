<mxfile host="app.diagrams.net"><diagram name="DFD-2. Регистрация пациента и ведение его данных (To-Be: меры защиты)" id="dfd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="1216" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;DFD-2. Регистрация пациента и ведение его данных (To-Be: меры защиты)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Администратор (ресепшен)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="180" height="70" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Врач-специалист&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="180" height="70" as="geometry"/></mxCell><mxCell id="6" value='&lt;b&gt;2.1 Собрать данные пациента&lt;br&gt;(анкета, расширенная форма,&lt;br&gt;договор)&lt;/b&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;минимизация: расширенная анкета -&lt;br&gt;только с отдельным согласием&lt;/i&gt;&lt;/font&gt;' style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="250" height="109" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;2.2 Зарегистрировать пациента в&lt;br&gt;списке&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="220" width="250" height="90" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;2.3 Сохранить документы пациента&lt;br&gt;(сканы, JPG, PDF)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="340" width="250" height="90" as="geometry"/></mxCell><mxCell id="9" value='&lt;b&gt;2.4 Использовать данные и медкарту&lt;br&gt;на приёме&lt;/b&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;врач видит только своих пациентов&lt;/i&gt;&lt;/font&gt;' style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="540" width="250" height="90" as="geometry"/></mxCell><mxCell id="10" value='&lt;b&gt;2.5 Переслать документы по почте&lt;br&gt;(ручной обмен)&lt;/b&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;заменить на защищённый обмен через&lt;br&gt;портал&lt;/i&gt;&lt;/font&gt;' style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="490" y="710" width="250" height="92" as="geometry"/></mxCell><mxCell id="11" value='&lt;b&gt;D2 Patients.xlsx - список пациентов&lt;/b&gt;&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;BitLocker AES-256 · тег PII · запись только&lt;br&gt;ресепшен&lt;/i&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="310" height="92" as="geometry"/></mxCell><mxCell id="12" value='&lt;b&gt;D3 Папка пациента Pacient-FIO-BD: анкеты,&lt;br&gt;договор, сканы, медицинская карта&lt;/b&gt;&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;шифрование папки (EFS, AES-256), ключи в&lt;br&gt;KMS · тег PII, PHI · доступ по роли&lt;/i&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1060" y="370" width="310" height="109" as="geometry"/></mxCell><mxCell id="13" value='&lt;b&gt;D4 Exchange Mail Server - почтовые ящики&lt;/b&gt;&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;TLS для SMTP и IMAP · DLP блокирует ПДн во&lt;br&gt;вложениях&lt;/i&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;dashed=1;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1060" y="710" width="310" height="92" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;2.6 Доставить письмо адресату&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="490" y="870" width="250" height="90" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Получатель письма (пациент, лаборатория,&lt;br&gt;коллега)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1060" y="880" width="310" height="70" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;IAM (Keycloak + AD): MFA, RBAC и&lt;br&gt;ABAC&lt;/b&gt;" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2E7D32;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="130" width="250" height="80" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;Каталог данных и теги (Apache&lt;br&gt;Atlas)&lt;/b&gt;" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2E7D32;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="280" width="250" height="80" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;Журнал аудита и SIEM (Elastic):&lt;br&gt;события доступа и алерты&lt;/b&gt;" style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="450" width="250" height="80" as="geometry"/></mxCell><mxCell id="19" value="&lt;b&gt;2.7 Проанализировать события и&lt;br&gt;оповестить (правила SIEM)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="600" width="250" height="70" as="geometry"/></mxCell><mxCell id="20" value="&lt;b&gt;Команда IT и ответственный за ПДн&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="740" width="250" height="70" as="geometry"/></mxCell><mxCell id="21" value='ФИО, дата рождения, телефон,&lt;br&gt;email; расширенная анкета: адрес&lt;br&gt;прописки, место работы или учёбы,&lt;br&gt;хронические заболевания&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;в MVP - через портал по TLS 1.3;&lt;br&gt;согласие на обработку ПДн&lt;br&gt;фиксируется&lt;/i&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2E7D32;" edge="1" parent="1" source="3" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value='ФИО, дата рождения, телефон, email&lt;br&gt;&lt;font color=