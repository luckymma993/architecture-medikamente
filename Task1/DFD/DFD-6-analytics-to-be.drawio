<mxfile host="app.diagrams.net"><diagram name="DFD-6. Аналитика и отчёты (To-Be: меры защиты)" id="dfd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="1066" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;DFD-6. Аналитика и отчёты (To-Be: меры защиты)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Бизнес-аналитик&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Руководство компании&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="180" height="70" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Сотрудники компании&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="250" height="70" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;6.1 Выгрузить данные из Excel и 1С&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="250" height="90" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;6.2 Подготовить данные (Jupyter,&lt;br&gt;Python)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="320" width="250" height="90" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;6.3 Построить отчёты (P&amp;L, ABC-&lt;br&gt;анализ)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="520" width="250" height="90" as="geometry"/></mxCell><mxCell id="9" value="&lt;b&gt;6.4 Вводить и править данные в&lt;br&gt;файлах и 1С&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="720" width="250" height="90" as="geometry"/></mxCell><mxCell id="10" value='&lt;b&gt;D1, D2, D8 Excel-файлы на общем диске:&lt;br&gt;журналы, пациенты, реестр анализов&lt;/b&gt;&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;доступ только через сервис обезличивания ·&lt;br&gt;тег PII, PHI&lt;/i&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="310" height="109" as="geometry"/></mxCell><mxCell id="11" value='&lt;b&gt;D5 1С:Бухгалтерия предприятия&lt;/b&gt;&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;доступ только через сервис обезличивания ·&lt;br&gt;тег FIN, HR, PII&lt;/i&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="310" height="92" as="geometry"/></mxCell><mxCell id="12" value='&lt;b&gt;6.0 Обезличить данные перед выгрузкой&lt;/b&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;псевдонимизация ID, удаление ФИО, телефона,&lt;br&gt;email, возраст в диапазон, адрес до региона&lt;/i&gt;&lt;/font&gt;' style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="470" width="310" height="90" as="geometry"/></mxCell><mxCell id="13" value='&lt;b&gt;D10 Витрина обезличенных данных&lt;br&gt;(ClickHouse)&lt;/b&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;доступ аналитика только к обезличенным&lt;br&gt;данным&lt;/i&gt;&lt;/font&gt;' style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;strokeColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="1060" y="660" width="310" height="109" as="geometry"/></mxCell><mxCell id="14" value="&lt;b&gt;IAM (Keycloak + AD): MFA, RBAC и&lt;br&gt;ABAC&lt;/b&gt;" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2E7D32;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="70" width="250" height="80" as="geometry"/></mxCell><mxCell id="15" value="&lt;b&gt;Каталог данных и теги (Apache&lt;br&gt;Atlas)&lt;/b&gt;" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2E7D32;strokeWidth=2;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="240" width="250" height="80" as="geometry"/></mxCell><mxCell id="16" value="&lt;b&gt;Журнал аудита и SIEM (Elastic):&lt;br&gt;события доступа и алерты&lt;/b&gt;" style="shape=partialRectangle;left=0;right=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="430" width="250" height="80" as="geometry"/></mxCell><mxCell id="17" value="&lt;b&gt;6.5 Проанализировать события и&lt;br&gt;оповестить (правила SIEM)&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="580" width="250" height="70" as="geometry"/></mxCell><mxCell id="18" value="&lt;b&gt;Команда IT и ответственный за ПДн&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1540" y="720" width="250" height="70" as="geometry"/></mxCell><mxCell id="19" value="запрос выгрузки" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="3" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value='данные для ввода и правки&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;вход через AD + MFA, роль по&lt;br&gt;должности&lt;/i&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2E7D32;" edge="1" parent="1" source="5" target="9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value='ввод и правка данных в файлах&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="9" target="10"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="750"/><mxPoint x="930" y="124"/></Array></mxGeometry></mxCell><mxCell id="22" value='ввод данных в 1С&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="9" target="11"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="965" y="780"/><mxPoint x="965" y="316"/></Array></mxGeometry></mxCell><mxCell id="23" value="обработка в Python" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value='отчёты P&amp;L и ABC-анализ&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;агрегированные отчёты без ПДн&lt;/i&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;strokeColor=#2E7D32;" edge="1" parent="1" source="8" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value='сырые данные&lt;br&gt;&lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; &lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;сервисная учётная запись, аудит&lt;br&gt;выгрузок&lt;/i&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0;exitY=0.8;entryX=0;entryY=0.3;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#2E7D32;" edge="1" parent="1" source="10" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="26" value='данные 1С&lt;br&gt;&lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="11" target="12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27" value='обезличенные данные&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="12" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value='выгрузка только из витрины&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="13" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value='обезличенные данные&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value='подготовленные данные&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="31" value="проверка роли и атрибутов" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=0;exitY=0.5;entryX=1;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="32" value="события доступа" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.75;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=0;exitY=0.5;entryX=1;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="события доступа" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.75;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="11" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="35" value="" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=0;exitY=0.5;entryX=1;entryY=0.25;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="14" target="13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="36" value="события доступа" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.75;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="37" value='записи журнала&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;OPS&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="16" target="17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="38" value='оповещения о нетипичных действиях,&lt;br&gt;отчёты аудита&lt;br&gt;&lt;font color="#595959"&gt;&lt;b&gt;OPS&lt;/b&gt;&lt;/font&gt;' style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;" edge="1" parent="1" source="17" target="18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="39" value="теги классификации" style="endArrow=block;endFill=1;html=1;fontSize=11;labelBackgroundColor=#ffffff;strokeWidth=1.5;edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;strokeColor=#2E7D32;fontColor=#2E7D32;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="40" value='&lt;b&gt;Обозначения&lt;/b&gt;&lt;br&gt;Прямоугольник - внешний субъект (человек или система)&lt;br&gt;Скруглённый блок - процесс; открытая полоса - хранилище данных; стрелка - поток данных&lt;br&gt;&lt;font color="#C00000"&gt;&lt;b&gt;PHI&lt;/b&gt;&lt;/font&gt; - медицинские данные (специальная категория ПДн, 152-ФЗ ст. 10); &lt;font color="#E36C09"&gt;&lt;b&gt;PII&lt;/b&gt;&lt;/font&gt; - персональные данные; &lt;font color="#1F4E9E"&gt;&lt;b&gt;FIN&lt;/b&gt;&lt;/font&gt; - платёжные и финансовые; &lt;font color="#7030A0"&gt;&lt;b&gt;HR&lt;/b&gt;&lt;/font&gt; - данные сотрудников; &lt;font color="#595959"&gt;&lt;b&gt;COM&lt;/b&gt;&lt;/font&gt; - коммерческие; &lt;font color="#2E7D32"&gt;&lt;b&gt;ANON&lt;/b&gt;&lt;/font&gt; - обезличенные; &lt;font color="#595959"&gt;&lt;b&gt;OPS&lt;/b&gt;&lt;/font&gt; - служебные события и оповещения&lt;br&gt;Пунктирная линия или рамка - предположение: в описании кейса этого прямо нет&lt;br&gt;&lt;font color="#2E7D32"&gt;&lt;i&gt;Зелёный курсив&lt;/i&gt;&lt;/font&gt; - мера защиты на узле или потоке. Зелёный пунктирный блок - компонент безопасности, зелёная пунктирная стрелка - управляющая связь (проверка, разметка), а не поток данных&lt;br&gt;Серый пунктир с зелёным курсивом - поток-предположение с мерой защиты (это поток данных, не управляющая связь)&lt;br&gt;Потоки без зелёной пометки идут внутри контура по тем же защищённым каналам (SMB 3 Encryption, TLS), доступ к хранилищам - через IAM' style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="1750" height="166" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>