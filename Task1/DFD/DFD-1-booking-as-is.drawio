<mxfile host="app.diagrams.net"><diagram name="DFD-1. Запись пациента к специалисту (As-Is)" id="dfd"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="742" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="&lt;b&gt;DFD-1. Запись пациента к специалисту (As-Is)&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1400" height="30" as="geometry"/></mxCell><mxCell id="3" value="&lt;b&gt;Пациент&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="180" height="70" as="geometry"/></mxCell><mxCell id="4" value="&lt;b&gt;Администратор (ресепшен)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="180" height="70" as="geometry"/></mxCell><mxCell id="5" value="&lt;b&gt;Врач-специалист&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="180" height="70" as="geometry"/></mxCell><mxCell id="6" value="&lt;b&gt;1.1 Принять обращение пациента о&lt;br&gt;записи&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="70" width="250" height="90" as="geometry"/></mxCell><mxCell id="7" value="&lt;b&gt;1.2 Занести запись в журнал&lt;br&gt;специалиста&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="260" width="250" height="90" as="geometry"/></mxCell><mxCell id="8" value="&lt;b&gt;1.3 Просмотреть и править журнал&lt;br&gt;приёма&lt;/b&g