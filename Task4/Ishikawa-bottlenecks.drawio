<mxfile host="app.diagrams.net"><diagram name="Task4. Диаграмма Исикавы" id="task4"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Задание 4. Диаграмма Исикавы: узкие места при миграции на новую архитектуру&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#212121;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="40" as="geometry"/></mxCell><mxCell id="c3" style="endArrow=block;endFill=1;html=1;strokeWidth=6;strokeColor=#37474F;endSize=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="900" as="sourcePoint"/><mxPoint x="2000" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="&lt;b&gt;Следствие&lt;/b&gt;&lt;br&gt;Падение производительности и стабильности новой системы при миграции и росте объёма данных в 5 раз" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B71C1C;strokeColor=#7F0000;fontColor=#FFFFFF;fontSize=21;arcSize=8;" vertex="1" parent="1"><mxGeometry x="2000" y="790" width="380" height="220" as="geometry"/></mxCell><mxCell id="c5" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="116" as="sourcePoint"/><mxPoint x="600" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;Инфраструктура&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#455A64;strokeColor=#455A64;fontColor=#FFFFFF;fontSize=18;arcSize=20;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="300" height="56" as="geometry"/></mxCell><mxCell id="c7" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="106.17346938775512" y="230" as="sourcePoint"/><mxPoint x="446.1734693877551" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;ИНФ-1&lt;/b&gt; Один сервер: AD, DNS, DHCP, файлы, Exchange, 1С. Нет резерва" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="110" y="156" width="334" height="72" as="geometry"/></mxCell><mxCell id="c9" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="132.57653061224488" y="345" as="sourcePoint"/><mxPoint x="472.5765306122449" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;ИНФ-2&lt;/b&gt; Миграция и рост ×5 делят CPU, память и диск с рабочими системами" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="137" y="271" width="334" height="72" as="geometry"/></mxCell><mxCell id="c11" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="158.9795918367347" y="460" as="sourcePoint"/><mxPoint x="498.9795918367347" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;ИНФ-3&lt;/b&gt; Диски не рассчитаны на нагрузку БД, ClickHouse и операции со сканами" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="163" y="386" width="334" height="72" as="geometry"/></mxCell><mxCell id="c13" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="185.38265306122446" y="575" as="sourcePoint"/><mxPoint x="525.3826530612245" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;ИНФ-4&lt;/b&gt; Филиалы работают через интернет с одной площадкой: задержки, узкий канал" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="189" y="501" width="334" height="72" as="geometry"/></mxCell><mxCell id="c15" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="211.78571428571422" y="690" as="sourcePoint"/><mxPoint x="551.7857142857142" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;ИНФ-5&lt;/b&gt; Нет расчёта ёмкости Kubernetes: лимиты ресурсов и масштабирование под ×5" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="216" y="616" width="334" height="72" as="geometry"/></mxCell><mxCell id="c17" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="238.1887755102041" y="805" as="sourcePoint"/><mxPoint x="578.1887755102041" y="805" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;ИНФ-6&lt;/b&gt; Сеть не разделена на сегменты: ККМ, серверы и рабочие места вместе" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="242" y="731" width="334" height="72" as="geometry"/></mxCell><mxCell id="c19" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="116" as="sourcePoint"/><mxPoint x="1030" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;Программное обеспечение и архитектура&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1565C0;strokeColor=#1565C0;fontColor=#FFFFFF;fontSize=18;arcSize=20;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="300" height="56" as="geometry"/></mxCell><mxCell id="c21" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="536.1734693877551" y="230" as="sourcePoint"/><mxPoint x="876.1734693877551" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c22" value="&lt;b&gt;ПО-1&lt;/b&gt; 1С в файловом режиме: блокировки при работе нескольких пользователей" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="540" y="156" width="334" height="72" as="geometry"/></mxCell><mxCell id="c23" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="562.5765306122449" y="345" as="sourcePoint"/><mxPoint x="902.5765306122449" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;ПО-2&lt;/b&gt; Монолитные системы с общими ресурсами: изменение одной части влияет на остальные" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="567" y="271" width="334" height="72" as="geometry"/></mxCell><mxCell id="c25" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588.9795918367347" y="460" as="sourcePoint"/><mxPoint x="928.9795918367347" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;ПО-3&lt;/b&gt; Шифрование полей лишает индексы смысла: поиск по ФИО и телефону идёт перебором" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="593" y="386" width="334" height="72" as="geometry"/></mxCell><mxCell id="c27" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="615.3826530612245" y="575" as="sourcePoint"/><mxPoint x="955.3826530612245" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;ПО-4&lt;/b&gt; Длинные синхронные цепочки: портал, шлюз, IAM, политики, сервис, БД" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="619" y="501" width="334" height="72" as="geometry"/></mxCell><mxCell id="c29" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="641.7857142857142" y="690" as="sourcePoint"/><mxPoint x="981.7857142857142" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;ПО-5&lt;/b&gt; Нет кэша ролей, справочников и решений политик: проверка прав на каждый запрос" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="646" y="616" width="334" height="72" as="geometry"/></mxCell><mxCell id="c31" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#1565C0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="668.1887755102041" y="805" as="sourcePoint"/><mxPoint x="1008.1887755102041" y="805" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;ПО-6&lt;/b&gt; Отчёты и BI читают рабочие БД напрямую" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="672" y="731" width="334" height="72" as="geometry"/></mxCell><mxCell id="c33" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1280" y="116" as="sourcePoint"/><mxPoint x="1460" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Интеграция&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6A1B9A;strokeColor=#6A1B9A;fontColor=#FFFFFF;fontSize=18;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1130" y="60" width="300" height="56" as="geometry"/></mxCell><mxCell id="c35" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="966.1734693877552" y="230" as="sourcePoint"/><mxPoint x="1306.1734693877552" y="230" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;ИНТ-1&lt;/b&gt; Обмен 1С - 1С и ККМ - 1С через OLE: привязка к Windows" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="970" y="156" width="334" height="72" as="geometry"/></mxCell><mxCell id="c37" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="992.5765306122448" y="345" as="sourcePoint"/><mxPoint x="1332.5765306122448" y="345" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;b&gt;ИНТ-2&lt;/b&gt; API лаборатории: пики запросов, таймауты и повторы" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="997" y="271" width="334" height="72" as="geometry"/></mxCell><mxCell id="c39" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1018.9795918367347" y="460" as="sourcePoint"/><mxPoint x="1358.9795918367347" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="&lt;b&gt;ИНТ-3&lt;/b&gt; Параллельный запуск: двойная запись и сверка удваивают нагрузку" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="1023" y="386" width="334" height="72" as="geometry"/></mxCell><mxCell id="c41" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045.3826530612246" y="575" as="sourcePoint"/><mxPoint x="1385.3826530612246" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="&lt;b&gt;ИНТ-4&lt;/b&gt; Нет единого стандарта контрактов для новых интеграций" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1049" y="501" width="334" height="72" as="geometry"/></mxCell><mxCell id="c43" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1071.7857142857142" y="690" as="sourcePoint"/><mxPoint x="1411.7857142857142" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;ИНТ-5&lt;/b&gt; Напоминания через Exchange: очередь и лимиты почтового сервера" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1076" y="616" width="334" height="72" as="geometry"/></mxCell><mxCell id="c45" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#6A1B9A;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1098.188775510204" y="805" as="sourcePoint"/><mxPoint x="1438.188775510204" y="805" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;ИНТ-6&lt;/b&gt; Нет очередей между сервисами: пик одного сервиса ложится на другие" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1102" y="731" width="334" height="72" as="geometry"/></mxCell><mxCell id="c47" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#00838F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1710" y="116" as="sourcePoint"/><mxPoint x="1890" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c48" value="&lt;b&gt;Данные и их миграция&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=