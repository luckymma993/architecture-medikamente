one;html=1;strokeWidth=2;strokeColor=#00838F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1475.3826530612246" y="575" as="sourcePoint"/><mxPoint x="1815.3826530612246" y="575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c56" value="&lt;b&gt;ДАН-4&lt;/b&gt; Данные меняются во время переноса" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1479" y="501" width="334" height="72" as="geometry"/></mxCell><mxCell id="c57" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#00838F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1501.7857142857142" y="690" as="sourcePoint"/><mxPoint x="1841.7857142857142" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="&lt;b&gt;ДАН-5&lt;/b&gt; Нет партиционирования и сроков хранения: таблицы растут вместе с ×5" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1506" y="616" width="334" height="72" as="geometry"/></mxCell><mxCell id="c59" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#00838F;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1528.188775510204" y="805" as="sourcePoint"/><mxPoint x="1868.188775510204" y="805" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c60" value="&lt;b&gt;ДАН-6&lt;/b&gt; Тяжёлые задания обезличивания и загрузки в озеро идут в рабочие часы" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1532" y="731" width="334" height="72" as="geometry"/></mxCell><mxCell id="c61" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="635" y="1700" as="sourcePoint"/><mxPoint x="815" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c62" value="&lt;b&gt;Безопасность и соответствие&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;strokeColor=#2E7D32;fontColor=#FFFFFF;fontSize=18;arcSize=20;" vertex="1" parent="1"><mxGeometry x="485" y="1700" width="300" height="56" as="geometry"/></mxCell><mxCell id="c63" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="453.625" y="995" as="sourcePoint"/><mxPoint x="793.625" y="995" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c64" value="&lt;b&gt;БЕЗ-1&lt;/b&gt; Шифрование, TLS и mTLS добавляют задержку и нагрузку на CPU" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="458" y="921" width="334" height="72" as="geometry"/></mxCell><mxCell id="c65" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="427.75" y="1110" as="sourcePoint"/><mxPoint x="767.75" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c66" value="&lt;b&gt;БЕЗ-2&lt;/b&gt; Аудит каждого чтения: журнал растёт быстрее данных, запись в SIEM тормозит запрос" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="432" y="1036" width="334" height="72" as="geometry"/></mxCell><mxCell id="c67" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="401.875" y="1225" as="sourcePoint"/><mxPoint x="741.875" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c68" value="&lt;b&gt;БЕЗ-3&lt;/b&gt; Хранилище ключей Vault: единая точка отказа и пик запросов к ключам" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="406" y="1151" width="334" height="72" as="geometry"/></mxCell><mxCell id="c69" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="376.0" y="1340" as="sourcePoint"/><mxPoint x="716.0" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c70" value="&lt;b&gt;БЕЗ-4&lt;/b&gt; Ротация ключей и перешифрование больших объёмов в рабочее время" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="380" y="1266" width="334" height="72" as="geometry"/></mxCell><mxCell id="c71" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350.125" y="1455" as="sourcePoint"/><mxPoint x="690.125" y="1455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c72" value="&lt;b&gt;БЕЗ-5&lt;/b&gt; DLP и сканирование нагружают почтовый и файловый серверы" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="354" y="1381" width="334" height="72" as="geometry"/></mxCell><mxCell id="c73" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#2E7D32;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="324.25" y="1570" as="sourcePoint"/><mxPoint x="664.25" y="1570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;БЕЗ-6&lt;/b&gt; Данные хранятся в РФ: ограничен выбор облака для быстрого масштабирования" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="328" y="1496" width="334" height="72" as="geometry"/></mxCell><mxCell id="c75" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065" y="1700" as="sourcePoint"/><mxPoint x="1245" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c76" value="&lt;b&gt;Персонал&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EF6C00;strokeColor=#EF6C00;fontColor=#FFFFFF;fontSize=18;arcSize=20;" vertex="1" parent="1"><mxGeometry x="915" y="1700" width="300" height="56" as="geometry"/></mxCell><mxCell id="c77" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="883.625" y="995" as="sourcePoint"/><mxPoint x="1223.625" y="995" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c78" value="&lt;b&gt;ПЕР-1&lt;/b&gt; ИТ-отдел из 3 человек ведёт старую систему и строит новую" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="888" y="921" width="334" height="72" as="geometry"/></mxCell><mxCell id="c79" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="857.75" y="1110" as="sourcePoint"/><mxPoint x="1197.75" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c80" value="&lt;b&gt;ПЕР-2&lt;/b&gt; Критичные знания у одного человека" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="862" y="1036" width="334" height="72" as="geometry"/></mxCell><mxCell id="c81" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="831.875" y="1225" as="sourcePoint"/><mxPoint x="1171.875" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="&lt;b&gt;ПЕР-3&lt;/b&gt; Бизнес-аналитик привык к Excel и Jupyter: озеро и ClickHouse потребуют обучения" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="836" y="1151" width="334" height="72" as="geometry"/></mxCell><mxCell id="c83" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="806.0" y="1340" as="sourcePoint"/><mxPoint x="1146.0" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c84" value="&lt;b&gt;ПЕР-4&lt;/b&gt; Сотрудники привыкли к Excel: двойной ввод и ошибки при переходе" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="810" y="1266" width="334" height="72" as="geometry"/></mxCell><mxCell id="c85" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="780.125" y="1455" as="sourcePoint"/><mxPoint x="1120.125" y="1455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c86" value="&lt;b&gt;ПЕР-5&lt;/b&gt; Быстрый найм: нет времени обучить правилам работы и защиты данных" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="784" y="1381" width="334" height="72" as="geometry"/></mxCell><mxCell id="c87" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#EF6C00;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="754.25" y="1570" as="sourcePoint"/><mxPoint x="1094.25" y="1570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c88" value="&lt;b&gt;ПЕР-6&lt;/b&gt; Нет ответственного за данные и ПДн" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="758" y="1496" width="334" height="72" as="geometry"/></mxCell><mxCell id="c89" style="endArrow=none;html=1;strokeWidth=4;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1495" y="1700" as="sourcePoint"/><mxPoint x="1675" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c90" value="&lt;b&gt;Процессы&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AD1457;strokeColor=#AD1457;fontColor=#FFFFFF;fontSize=18;arcSize=20;" vertex="1" parent="1"><mxGeometry x="1345" y="1700" width="300" height="56" as="geometry"/></mxCell><mxCell id="c91" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1313.625" y="995" as="sourcePoint"/><mxPoint x="1653.625" y="995" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c92" value="&lt;b&gt;ПРО-1&lt;/b&gt; Нет базовых метрик As-Is: нечего сравнить после переключения" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="1318" y="921" width="334" height="72" as="geometry"/></mxCell><mxCell id="c93" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1287.75" y="1110" as="sourcePoint"/><mxPoint x="1627.75" y="1110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c94" value="&lt;b&gt;ПРО-2&lt;/b&gt; Нет нагрузочного тестирования на ×5" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="1292" y="1036" width="334" height="72" as="geometry"/></mxCell><mxCell id="c95" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1261.875" y="1225" as="sourcePoint"/><mxPoint x="1601.875" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c96" value="&lt;b&gt;ПРО-3&lt;/b&gt; Нет плана переключения, критериев успеха и отката" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#B71C1C;spacing=2;" vertex="1" parent="1"><mxGeometry x="1266" y="1151" width="334" height="72" as="geometry"/></mxCell><mxCell id="c97" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1236.0" y="1340" as="sourcePoint"/><mxPoint x="1576.0" y="1340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c98" value="&lt;b&gt;ПРО-4&lt;/b&gt; Ручное развёртывание, нет автоматической проверки релизов" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1240" y="1266" width="334" height="72" as="geometry"/></mxCell><mxCell id="c99" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210.125" y="1455" as="sourcePoint"/><mxPoint x="1550.125" y="1455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c100" value="&lt;b&gt;ПРО-5&lt;/b&gt; Все домены переносятся сразу, а не поэтапно" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1214" y="1381" width="334" height="72" as="geometry"/></mxCell><mxCell id="c101" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#AD1457;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1184.25" y="1570" as="sourcePoint"/><mxPoint x="1524.25" y="1570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c102" value="&lt;b&gt;ПРО-6&lt;/b&gt; Не определены RTO и RPO" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontSize=15;fontColor=#212121;spacing=2;" vertex="1" parent="1"><mxGeometry x="1188" y="1496" width="334" height="72" as="geometry"/></mxCell><mxCell id="c103" value="Красный текст - критичная причина: для неё есть мера приоритета P1. Идентификатор причины (например, ПО-3) совпадает с идентификатором в отчёте README. Причины - гипотезы для проверки метриками из отчёта." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#424242;" vertex="1" parent="1"><mxGeometry x="40" y="1800" width="2300" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>