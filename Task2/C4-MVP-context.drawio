&gt;&lt;font color="#e6e6e6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="52"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2E7D32;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1B5E20;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1"><mxGeometry x="1760" y="1300" width="270" height="150" as="geometry"/></mxCell></object><object placeholders="1" c4Name="Озеро обезличенных данных" c4Type="Software System" c4Description="ClickHouse: слои RAW, PROCESSED, GOLDEN. Только данные с тегом ANON" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#e6e6e6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="53"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2E7D32;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1B5E20;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1"><mxGeometry x="2270" y="1300" width="270" height="140" as="geometry"/></mxCell></object><object placeholders="1" c4Name="BI и ML" c4Type="Software System" c4Description="Jupyter и BI-отчёты (P&amp;L, ABC-анализ), обучение моделей на обезличенных данных" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#e6e6e6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="54"><mxCell style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2E7D32;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1B5E20;metaEdit=1;resizable=0;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" parent="1" vertex="1"><mxGeometry x="2270" y="1600" width="270" height="140" as="geometry"/></mxCell></object><mxCell id="55" value="&lt;b&gt;Как блоки реализуют Privacy by Design&lt;/b&gt;&lt;br&gt;&lt;b&gt;Приватность по умолчанию:&lt;/b&gt; порталы и сервисы доступны только через шлюз и IAM, права по ролям (RBAC) и атрибутам (ABAC).&lt;br&gt;&lt;b&gt;Защита на всём жизненном цикле:&lt;/b&gt; шифрование в покое и при передаче, ключи в Vault отдельно от данных.&lt;br&gt;&lt;b&gt;Минимизация данных:&lt;/b&gt; данные разнесены по доменам, сервис записи не хранит медицинские подробности, аналитика получает только обезличенные наборы.&lt;br&gt;&lt;b&gt;Прозрачность:&lt;/b&gt; теги и Data Lineage в каталоге, журнал аудита, оповещения команде IT и ответственному за ПДн.&lt;br&gt;&lt;b&gt;Проактивность:&lt;/b&gt; релиз проверяется автоматически на теги и шифрование до выхода в работу." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fillColor=#ffffff;strokeColor=#999999;spacing=8;" vertex="1" parent="1"><mxGeometry x="1715" y="1850" width="870" height="150" as="geometry"/></mxCell><object placeholders="1" c4Name="IT team and DPO" c4Type="Person" c4Description="Команда IT и ответственный за ПДн" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#e6e6e6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="56"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="2790" y="520" width="200" height="180" as="geometry"/></mxCell></object><object placeholders="1" c4Name="Business analyst" c4Type="Person" c4Description="Бизнес-аналитик" label='&lt;font style="font-size: 16px"&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style="font-size: 11px"&gt;&lt;font color="#e6e6e6"&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;' id="57"><mxCell style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="2790" y="1560" width="200" height="180" as="geometry"/></mxCell></object><object placeholders="1" c4Type="Relationship" c4Description="Запись на приём, просмотр своих данных" c4Technology="HTTPS, TLS 1.3" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="58"><mxCell style="endArrow=blockThin;html=1;fontSize=12;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor=#ffffff;" parent="1" source="21" target="30" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object><object placeholders="1" c4Type="Relationship" c4Description="Ведение записей и карт пациентов" c4Technology="HTTPS, MFA" label='&lt;div style="text-align: left"&gt;&lt;div style="text-align: center"&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style="text-align: center"&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;' id="59"><mxCell style="endArrow=blockThin;html=1;fontSize=12;fontColor=#404040;strokeWidth=1.5;endFill=1;strokeColor=#828282;elbow=vertical;metaEdit=1;endSize=14;startSize=14;jumpStyle=arc;jumpSize=16;rounded=0;edgeStyle=orthogonalEdgeStyle;labelBackgroundColor